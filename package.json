{
  "name": "max-maciel-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "predev:api": "node scripts/free-port.mjs 3000",
    "dev:api": "tsx scripts/local-api.mts",
    "dev:api:vercel": "vercel dev --listen 3000",
    "dev:full": "concurrently -k -n api,vite -c blue,green \"npm run dev:api\" \"vite\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/oidc": "^3.8.4",
    "framer-motion": "^12.42.2",
    "google-news-url-decoder": "^1.2.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.1.14",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vercel": "^41.7.0",
    "vite": "^8.1.1"
  }
}
