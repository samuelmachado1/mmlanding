# Google Custom Search JSON API
# 1. Crie um projeto em https://console.cloud.google.com/
# 2. Habilite "Custom Search API" e gere uma API Key
# 3. Crie um motor em https://programmablesearchengine.google.com/ e copie o Search Engine ID (cx)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Protege o endpoint de cron (Vercel envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Token do Vercel Blob (gerado ao criar um Blob store no dashboard Vercel)
BLOB_READ_WRITE_TOKEN=
