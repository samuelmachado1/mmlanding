# Busca de notícias — padrão: Google News RSS (sem API key, igual ao projeto get-news)
# Opcional: queries JSON. Ex: ["Max Maciel deputado","Max Maciel CTM"]
GOOGLE_NEWS_QUERIES=

# Opcional: Custom Search API (requer billing no Google Cloud). Só usa se GOOGLE_CSE_ENABLED=true
GOOGLE_CSE_ENABLED=false
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_QUERIES=

# Autenticação do admin (/max-admin e /api/admin/*)
ADMIN_SECRET=

# Vercel Blob (obrigatório em produção para buscar/aprovar/publicar matérias)
# Na Vercel: Storage → Blob → Connect to Project (Production) → redeploy
# BLOB_READ_WRITE_TOKEN e BLOB_STORE_ID são injetados automaticamente ao conectar
BLOB_READ_WRITE_TOKEN=
