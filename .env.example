# Google Custom Search JSON API
# 1. Crie um projeto em https://console.cloud.google.com/
# 2. Habilite "Custom Search API" e gere uma API Key
# 3. Crie um motor em https://programmablesearchengine.google.com/ e copie o Search Engine ID (cx)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Protege o endpoint de cron (Vercel envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Token do Vercel Blob (gerado ao criar um Blob store no dashboard Vercel)
BLOB_READ_WRITE_TOKEN=

# Controle de lançamento (middleware)
# Data de abertura pública (fuso America/Sao_Paulo). Antes disso, visitantes veem "Em breve".
LAUNCH_DATE=2026-08-15
# Força o site público antes da data (use no dia do lançamento ou para override)
SITE_LAUNCHED=false
# Segredo para preview em produção: https://seu-dominio.com/?preview=SEU_SEGREDO
PREVIEW_SECRET=
