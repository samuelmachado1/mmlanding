# Busca de notícias — padrão: Google News RSS (sem API key, igual ao projeto get-news)
# Opcional: queries JSON. Ex: ["Max Maciel deputado","Max Maciel CTM"]
GOOGLE_NEWS_QUERIES=

# Opcional: Custom Search API (requer billing no Google Cloud). Só usa se GOOGLE_CSE_ENABLED=true
GOOGLE_CSE_ENABLED=false
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_QUERIES=

# Protege o endpoint de cron (Vercel envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Autenticação do admin (/admin/midia e /api/admin/*)
ADMIN_SECRET=
