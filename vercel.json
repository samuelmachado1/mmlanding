{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/admin/clippings/[action].ts": {
      "maxDuration": 30
    },
    "api/clippings.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/coming-soon.html", "destination": "/coming-soon.html" },
    { "source": "/api/clippings/item", "destination": "/api/clippings" },
    { "source": "/((?!api/|coming-soon\\.html).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/max-admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
