{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/coming-soon.html", "destination": "/coming-soon.html" },
    { "source": "/((?!api/|coming-soon\\.html).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-clippings",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
